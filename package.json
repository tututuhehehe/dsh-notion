{
  "name": "dsh-notion",
  "version": "0.3.0",
  "description": "Four consolidated Notion tools for DeepSeek Harness over the official ntn CLI: search, get, page, query",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "notion",
    "tools",
    "ntn"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tututuhehehe/dsh-notion.git"
  },
  "scripts": {
    "build": "esbuild src/dsh/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
